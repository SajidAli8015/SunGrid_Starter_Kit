# Copy to .env (git-ignored) and fill in the block for the provider you use.
# Placeholders only. Never commit real values.

# Which provider to use: azure_openai | openai | anthropic | gemini | fake
# Overrides llm.provider in config/config.yaml.
LLM_PROVIDER=azure_openai

# --- Azure OpenAI (the only provider tested end to end) ---
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
# Resource root. A full request URL copied from the portal (with /openai/deployments/...
# and ?api-version=...) is also accepted; it is normalised to the root.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# Deployment name, used as the model.
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# Optional. Precedence: this variable, then ?api-version= in the endpoint, then 2024-02-01.
AZURE_OPENAI_API_VERSION=

# --- OpenAI (untested) ---
OPENAI_API_KEY=<your-openai-key>
OPENAI_MODEL=<model-name>

# --- Anthropic (untested) ---
ANTHROPIC_API_KEY=<your-anthropic-key>
ANTHROPIC_MODEL=<model-name>

# --- Google Gemini (untested) ---
GEMINI_API_KEY=<your-gemini-key>
GEMINI_MODEL=<model-name>
